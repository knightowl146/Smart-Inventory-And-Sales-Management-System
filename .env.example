# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Configuration
#
# IMPORTANT: purchaseProduct and sellProduct run inside a Mongoose transaction
# (Product update + StockMovement create must commit atomically), and MongoDB
# only supports transactions against a replica set - a standalone mongod will
# fail with "Transaction numbers are only allowed on a replica set member".
#
# For local MongoDB, first initialize a single-node replica set once:
#   mongod --replSet rs0 --dbpath <your-db-path>
#   mongosh --eval "rs.initiate()"
# Then connect with replicaSet in the URI:
MONGO_URI=mongodb://localhost:27017/smart-inventory-db?replicaSet=rs0
#
# For MongoDB Atlas (cloud) - Atlas clusters are already replica sets, so no
# extra query param is needed:
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/databasename

# Google Gemini API (Optional - for AI-powered stock recommendations)
# Get your API key from: https://makersuite.google.com/app/apikey
# Note: System works without this key using deterministic calculations
GEMINI_API_KEY=your_gemini_api_key_here

# CORS (required in production, optional in development)
#
# Comma-separated list of frontend origin(s) allowed to call this API from a
# browser, e.g. https://your-app.vercel.app. In development, leaving this
# unset allows any origin so local Vite ports (5173, etc.) just work. In
# production, leaving this unset blocks all cross-origin browser requests.
CORS_ORIGIN=https://your-frontend-domain.example.com

# ─── Authentication ──────────────────────────────────────────────────────────
#
# Two separate secrets, so a leak of one cannot be used to mint the other kind
# of token. REQUIRED in production - the server refuses to start without strong
# values. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=generate_a_long_random_value
JWT_REFRESH_SECRET=generate_a_different_long_random_value

# Access tokens are short because they are held in browser memory and refreshed
# silently; the refresh token in the httpOnly cookie is what keeps a session
# alive across reloads.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# First-owner bootstrap. Read only by `npm run seed:owner`, never by the running
# server. There is no public sign-up route: every account after this one is
# created by an owner from the Staff page.
OWNER_NAME=Shop Owner
OWNER_EMAIL=
OWNER_PASSWORD=

# ─── AI features ─────────────────────────────────────────────────────────────
#
# All AI features degrade rather than break without a key: the assistant says it
# is unconfigured, anomalies render with their numbers and no commentary, and
# briefings are written deterministically from the same figures.
#
# A soft cap on estimated spend per calendar month. When it is reached, AI calls
# stop and every feature falls back to its deterministic path rather than
# running up a bill. Usage is visible at GET /api/ai/usage.
AI_MONTHLY_BUDGET_USD=5

# How many days a generated briefing covers. Used by `npm run briefing`.
BRIEFING_DAYS=7

# ─── Receipts ────────────────────────────────────────────────────────────────
#
# Printed at the top of every sale receipt. All optional - the receipt renders
# without them.
SHOP_NAME=Your Shop Name
SHOP_ADDRESS=
SHOP_PHONE=

# ─── Demo mode ───────────────────────────────────────────────────────────────
#
# Only for a public demo deployment. `npm run reset:demo` wipes EVERY product,
# movement, customer, supplier and user account, then reseeds from scratch - so
# it refuses to run unless DEMO_MODE is explicitly true, and refuses again if
# the database name does not look like a demo one unless DEMO_RESET_CONFIRM is
# also set. Do not set these on a database you care about.
DEMO_MODE=false
# DEMO_RESET_CONFIRM=false
DEMO_HISTORY_DAYS=180

# The accounts the reset recreates. Put the same values in Vercel as
# VITE_DEMO_OWNER / VITE_DEMO_EMPLOYEE so the login page shows them to visitors.
DEMO_OWNER_EMAIL=owner@demo.local
DEMO_OWNER_PASSWORD=
DEMO_EMPLOYEE_EMAIL=staff@demo.local
DEMO_EMPLOYEE_PASSWORD=

# ─── Seeding ─────────────────────────────────────────────────────────────────
#
# Overrides MONGO_URI for the seed scripts only, so you can populate Atlas
# without editing .env:
#   SEED_MONGO_URI="mongodb+srv://..." npm run seed:history
# SEED_MONGO_URI=
