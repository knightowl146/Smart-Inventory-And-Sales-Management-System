{
  "name": "smart-inventory-management-system",
  "version": "1.0.0",
  "description": "A comprehensive backend system for managing inventory, sales, purchases, and business analytics with AI-powered stock recommendations",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seedProducts.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --forceExit",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --runInBand --forceExit",
    "seed:owner": "node seedOwner.js",
    "briefing": "node generateBriefingJob.js",
    "seed:history": "node seedHistory.js",
    "reset:demo": "node resetDemo.js"
  },
  "overrides": {
    "mongodb-memory-server-core": {
      "mongodb": "7.5.0"
    }
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 120000,
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ]
  },
  "keywords": [
    "inventory-management",
    "sales-management",
    "analytics",
    "reporting",
    "ai-recommendations",
    "stock-management",
    "business-intelligence"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@exortek/express-mongo-sanitize": "^3.0.1",
    "@google/genai": "^2.20.0",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "envalid": "^8.2.0",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.7.4",
    "morgan": "^1.12.0",
    "multer": "^2.4.0",
    "nodemon": "^3.1.14",
    "pdfkit": "^0.20.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=9.0.0"
  }
}
