# Leave this as /api. The request is proxied to the backend by Vite in
# development and by Vercel in production, so the browser only ever sees one
# origin - which is what lets the httpOnly refresh cookie stay first-party.
VITE_API_BASE_URL=/api

# Where the dev proxy forwards /api. Only used by `npm run dev`.
VITE_DEV_API_TARGET=http://localhost:3000

# Optional. Set these on the deployed portfolio build and the login page grows
# a "Sign in as owner / Sign in as employee" pair of buttons, so a visitor can
# try both roles without typing anything. Leave unset and the block does not
# render at all.
#
# Format is "email / password" - split on the FIRST slash, so a password
# containing one still parses. Use the same values as the backend's
# DEMO_OWNER_EMAIL / DEMO_OWNER_PASSWORD so the nightly reset recreates
# accounts these buttons can actually sign in to.
# VITE_DEMO_OWNER=owner@demo.local / demo-owner-pass
# VITE_DEMO_EMPLOYEE=staff@demo.local / demo-staff-pass
